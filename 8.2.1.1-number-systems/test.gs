function shuffle_(arr) {
  var a = arr.slice();
  for (var i = a.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i + 1));
    var t = a[i]; a[i] = a[j]; a[j] = t;
  }
  return a;
}

function createTest() {
  var form = FormApp.create(TITLE);
  form.setIsQuiz(true)
      .setDescription('8 класс. Перевод натуральных чисел между системами счисления с основаниями 2, 8, 10, 16.\n' +
                      'Каждый вопрос — 1 балл. Выберите один правильный ответ.')
      .setRequireLogin(true)
      .setLimitOneResponsePerUser(true)
      .setShuffleQuestions(true)
      .setAllowResponseEdits(false)
      .setPublishingSummary(false)
      .setProgressBar(true);
  try {
    form.setCollectEmail(true);
  } catch (e) {
    // В новых версиях Forms сбор адресов включается в настройках формы вручную.
  }

  form.addTextItem().setTitle('Фамилия и имя').setRequired(true);
  form.addPageBreakItem().setTitle('Вопросы');

  QUESTIONS.forEach(function (item) {
    var mc = form.addMultipleChoiceItem();
    var choices = shuffle_(item.a.map(function (text, i) {
      return mc.createChoice(text, i === 0);
    }));
    mc.setTitle(item.q)
      .setChoices(choices)
      .setPoints(1)
      .setRequired(true)
      .setFeedbackForIncorrect(FormApp.createFeedback().setText('Решение: ' + item.hint).build());
  });

  var ss = SpreadsheetApp.create(TITLE + ' — результаты');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());

  Logger.log('Ссылка для учеников:  ' + form.getPublishedUrl());
  Logger.log('Редактирование теста: ' + form.getEditUrl());
  Logger.log('Таблица результатов:  ' + ss.getUrl());
}
